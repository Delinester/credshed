# Normalize line endings: store text as LF, check out LF everywhere.
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.config text eol=lf
*.service text eol=lf
*.txt   text eol=lf

# Binary (never touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
